# ---- Backend ----
# Comma-separated provider keys, at least 2. Ids are key_1, key_2, ... in this order. NEVER commit real keys.
LLM_API_KEYS=replace-with-key-1,replace-with-key-2
# Any LiteLLM model string. Must match the provider your keys belong to.
LLM_MODEL=gemini/gemini-3.8-flash-lite
# SQLite location. In Docker this lives on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated browser origins allowed by CORS (your frontend URL, no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test header (required to be true on the deployed backend).
ENABLE_FAILURE_SIMULATION=true
CACHE_ENABLED=true
# local = in-memory, disk = persisted under CACHE_DIR
CACHE_TYPE=local
CACHE_DIR=/data/llm_cache
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.
LOG_LEVEL=INFO
LLM_TIMEOUT_SECONDS=30

# ---- Frontend (build-time) ----
# URL the BROWSER uses to reach the backend.
VITE_API_BASE_URL=http://localhost:8000
